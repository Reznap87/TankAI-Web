TANKAI_ID_SALT=
TANKAI_DAILY_REQUEST_LIMIT=30
TANKAI_DAILY_MODEL_CALL_LIMIT=120

# Zentrale Egress-Richtlinie für web.fetch. Ohne Allowlist bleibt Netzwerkzugriff gesperrt.
# Exakte Hosts und Wildcard-Subdomains kommasepariert, z. B. example.com,*.wikipedia.org
TANKAI_EGRESS_ALLOWED_HOSTS=
TANKAI_EGRESS_DENIED_HOSTS=

OPENAI_API_KEY=
TANKAI_OPENAI_SOL_MODEL=gpt-5.6-sol
TANKAI_OPENAI_TERRA_MODEL=gpt-5.6-terra
TANKAI_OPENAI_LUNA_MODEL=gpt-5.6-luna

XAI_API_KEY=
XAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_CHAT_COMPLETIONS_URL=

# Langzeitgedächtnis (serverseitig, D1)
TANKAI_MEMORY_RECALL_LIMIT=8
TANKAI_MEMORY_RECALL_CANDIDATES=160
TANKAI_MEMORY_MAX_HOT_ENTRIES=400
TANKAI_MEMORY_WARM_AFTER_DAYS=14
TANKAI_MEMORY_COLD_AFTER_DAYS=90
TANKAI_MEMORY_EPISODIC_TTL_DAYS=365
